# ============== CONFIGURACIÓN DE BASE DE DATOS ==============
DB_ENGINE=sqlite
SQLITE_FILE=./inventario.db

# Para usar MySQL/XAMPP, descomenta estas líneas y cambia DB_ENGINE a mysql:
# DB_ENGINE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=inventario_medicamentos

# ============== CONFIGURACIÓN DE APIs ==============
# Google Custom Search API (opcional)
# Obtener keys desde: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ============== CONFIGURACIÓN DE APLICACIÓN ==============
DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=development

# ============== CONFIGURACIÓN DE MONEDA ==============
MONEDA=$
IDIOMA=es

# ============== NOTA ==============
# Este archivo contiene valores por defecto.
# Para usar valores personalizados, edita este archivo.
# IMPORTANTE: No commits este archivo si contiene información sensible.
