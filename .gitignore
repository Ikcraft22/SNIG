# ============================================================
# .gitignore — Sistema de Inventario y POS
# ============================================================

# ── Entorno virtual ──────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python compilado / cachés ────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
*.cover
*.coverage
.coverage
htmlcov/

# ── Secrets y configuración local ───────────────────────────
.env
.env.*
.env.local
.env.production
secrets.json
secrets.yaml
# Permitir plantillas de configuración sin secretos.
!.env.example
!.env.*.example

# ── Base de datos y archivos de datos locales ────────────────
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
backups/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Estado de la app / archivos temporales ───────────────────
.startup_state.json
*.autosave
*.bak
*.tmp
*.temp

# ── Recursos del proyecto ────────────────────────────────────
# Logo.ico e Icono.jpeg son requeridos por la GUI y el build.
# Mantener fuera el icono legado y el archivo de trabajo redundante.
Icono.ico
/Logo.af

# ── IDE / Editores ───────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ── Sistema operativo ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ── Empaquetado / distribución ───────────────────────────────
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Las especificaciones *.spec son configuración fuente de PyInstaller
# y se versionan junto con el código.

# ── Reportes y exportaciones generadas ──────────────────────
exports/
reportes_generados/
