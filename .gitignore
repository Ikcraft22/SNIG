# ============================================================
# .gitignore — Sistema de Inventario y POS
# ============================================================

# ── Entorno virtual ──────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python compilado / cachés ────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyw
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
*.cover
*.coverage
.coverage
htmlcov/

# ── Secrets y configuración local ───────────────────────────
.env
.env.*
.env.local
.env.production
*.local
secrets.json
secrets.yaml

# ── Base de datos y archivos de datos locales ────────────────
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
backups/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Estado de la app / archivos temporales ───────────────────
.startup_state.json
*.autosave
*.bak
*.tmp
*.temp

# ── Binarios e iconos grandes (no necesarios en repo) ────────
*.af
*.rar
*.zip
*.tar.gz
# Mantener Logo.svg (vectorial, liviano) pero ignorar binarios pesados
Logo.ico
Logo.af
Icono.ico
Icono.jpeg
Icono.webp

# ── IDE / Editores ───────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ── Sistema operativo ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ── Empaquetado / distribución ───────────────────────────────
build/
dist/
*.egg-info/
*.egg
MANIFEST
site/

# ── PyInstaller ──────────────────────────────────────────────
*.spec

# ── Reportes y exportaciones generadas ──────────────────────
exports/
reportes_generados/
